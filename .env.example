# ==============================================================================
# VED-HUB / NexaCart Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production deployment on Vercel:
#   Add these variables in your Vercel Project Settings > Environment Variables.
# ==============================================================================

# ─── Database Configuration ───────────────────────────────────────────────────
#
# LOCAL DEVELOPMENT (SQLite):
# Uses local zero-configuration SQLite database.
DATABASE_URL="file:./dev.db"

# PRODUCTION (PostgreSQL on Vercel, Neon, Supabase, or Railway):
# When deploying to Vercel, set DATABASE_URL to your PostgreSQL connection string.
# Our automated builder (`scripts/prisma-prepare.js`) detects postgresql:// and
# automatically configures Prisma for PostgreSQL and builds with Linux serverless targets.
#
# Examples:
#   Neon:     postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres.xyz:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
#   Vercel:   postgresql://default:password@ep-xyz.postgres.vercel-storage.com:5432/verceldb?sslmode=require
#
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── Authentication & Session Security ────────────────────────────────────────
# REQUIRED: Strong 32+ character random secret used to sign JWT session cookies.
# Generate a secure secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-secure-random-32-char-string-in-production"

# ─── App Environment & Public URL ─────────────────────────────────────────────
# Local development:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# Production on Vercel:
# NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
# NODE_ENV="production"

# ─── Razorpay Payment Gateway ─────────────────────────────────────────────────
# Obtain from Razorpay Dashboard (Settings > API Keys):
# Test keys start with "rzp_test_", Live keys start with "rzp_live_"
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="dev_razorpay_secret_key_testing"

# Webhook Secret from Razorpay Dashboard (Settings > Webhooks):
RAZORPAY_WEBHOOK_SECRET="dev_razorpay_webhook_secret_testing"

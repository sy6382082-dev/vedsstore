{
  "name": "nexacart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/prisma-prepare.js",
    "build": "node scripts/prisma-prepare.js && next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:prepare": "node scripts/prisma-prepare.js",
    "prisma:prepare:pg": "node scripts/prisma-prepare.js --force-pg",
    "prisma:prepare:sqlite": "node scripts/prisma-prepare.js --force-sqlite",
    "db:push:pg": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "db:push:sqlite": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:export": "tsx scripts/export-sqlite-data.ts",
    "db:import:pg": "tsx scripts/import-postgres-data.ts",
    "admin:provision": "tsx scripts/provision-admin.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.13",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "prisma": "5.22.0",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
